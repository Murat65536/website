---
import { getWakaTimeStats } from '../lib/wakatime';

const stats = await getWakaTimeStats();
---

<section class="coding-activity-section">
  <h4>Coding Activity</h4>
  <p><strong>Since</strong>: {stats.since}</p>
  <p><strong>Total</strong>: {stats.totalHours.toLocaleString()} hrs</p>
  <p><strong>Daily Average</strong>: {stats.dailyAverageHours} hrs</p>
  <p><strong>Last 30 Days</strong>: {stats.last30DaysHours} hrs</p>
  <p><strong>Languages</strong>: {stats.languages.map(l => `${l.name} (${l.percent}%)`).join(', ')}</p>
  <p><strong>Editors</strong>: {stats.editors.map(e => `${e.name} (${e.percent}%)`).join(', ')}</p>
  <p><strong>Operating Systems</strong>: {stats.os.map(o => `${o.name} (${o.percent}%)`).join(', ')}</p>
</section>

<style>
  .coding-activity-section {
    margin-top: 2.25rem;
  }
</style>
